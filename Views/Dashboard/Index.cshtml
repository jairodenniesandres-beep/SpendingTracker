@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var monthName = Model.Today.ToString("MMMM yyyy");
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Overview for @monthName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Expenses" asp-action="Index" class="btn btn-outline-secondary">View expenses</a>
        <a asp-controller="Expenses" asp-action="Create" class="btn btn-primary">Add Expense</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">This month</h6>
                <p class="card-text display-6 fs-3 mb-1">@Model.ThisMonthTotal.ToString("C")</p>
                <small class="text-muted">@Model.ThisMonthCount expense(s)</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Last month</h6>
                <p class="card-text display-6 fs-3 mb-0">@Model.LastMonthTotal.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Change vs last month</h6>
                @if (Model.ChangePercent is decimal change)
                {
                    <p class="card-text display-6 fs-3 mb-1 @(change > 0 ? "text-danger" : change < 0 ? "text-success" : "")">
                        @(change > 0 ? "+" : "")@change.ToString("0.0")%
                    </p>
                    <small class="text-muted">@(change > 0 ? "Spending more" : change < 0 ? "Spending less" : "No change") (month to date)</small>
                }
                else
                {
                    <p class="card-text display-6 fs-3 mb-1">—</p>
                    <small class="text-muted">No spending last month</small>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">This year (@Model.Today.Year)</h6>
                <p class="card-text display-6 fs-3 mb-0">@Model.ThisYearTotal.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Average per day (this month)</h6>
                <p class="card-text display-6 fs-3 mb-1">@Model.AveragePerDayThisMonth.ToString("C")</p>
                <small class="text-muted">Over @Model.Today.Day day(s)</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-2">Total expenses recorded</h6>
                <p class="card-text display-6 fs-3 mb-0">@Model.ExpenseCount</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <section class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h4 class="h5 mb-0">Spending by category — @monthName</h4>
            </div>
            <div class="card-body">
                @if (Model.CategorySpending.Count == 0)
                {
                    <p class="text-muted mb-0">No spending this month yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th class="text-end">Spent</th>
                                    <th class="text-end">Budget</th>
                                    <th class="text-end">Remaining</th>
                                    <th class="text-end">Used</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CategorySpending)
                                {
                                    <tr>
                                        <td><a asp-controller="Expenses" asp-action="Index" asp-route-CategoryId="@c.CategoryId" asp-route-From="@Model.Today.ToString("yyyy-MM-01")">@c.Name</a></td>
                                        <td class="text-end">@c.Spent.ToString("C")</td>
                                        <td class="text-end">@(c.Budget?.ToString("C") ?? "—")</td>
                                        <td class="text-end @(c.Remaining < 0 ? "text-danger fw-semibold" : "")">@(c.Remaining?.ToString("C") ?? "—")</td>
                                        <td class="text-end @(c.PercentUsed > 100 ? "text-danger fw-semibold" : "")">@(c.PercentUsed is decimal p ? p.ToString("0.0") + "%" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Total</th>
                                    <th class="text-end">@Model.ThisMonthTotal.ToString("C")</th>
                                    <th class="text-end">@(Model.TotalBudget?.ToString("C") ?? "—")</th>
                                    <th class="text-end">@(Model.TotalBudget is decimal tb ? (tb - Model.ThisMonthTotal).ToString("C") : "—")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="col-lg-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h4 class="h5 mb-0">Last 6 months</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Month</th>
                                <th class="text-end">Expenses</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.LastSixMonths)
                            {
                                <tr>
                                    <td>@m.Month.ToString("MMMM yyyy")</td>
                                    <td class="text-end">@m.Count</td>
                                    <td class="text-end">@m.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Total</th>
                                <th class="text-end">@Model.LastSixMonths.Sum(m => m.Count)</th>
                                <th class="text-end">@Model.LastSixMonths.Sum(m => m.Total).ToString("C")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<section class="mb-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h4 class="h5 mb-0">Recent expenses</h4>
            <div class="d-flex gap-2">
                <a asp-controller="Expenses" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all</a>
                <a asp-controller="Expenses" asp-action="Create" class="btn btn-sm btn-primary">Add Expense</a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.RecentExpenses.Count == 0)
            {
                <p class="text-muted mb-0">No expenses yet. <a asp-controller="Expenses" asp-action="Create">Add your first one</a>.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Payment Method</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.RecentExpenses)
                            {
                                <tr>
                                    <td>@e.Date.ToString("d")</td>
                                    <td><a asp-controller="Expenses" asp-action="Details" asp-route-id="@e.Id">@e.Title</a></td>
                                    <td>@e.Category?.Name</td>
                                    <td>@e.PaymentMethod.GetDisplayName()</td>
                                    <td class="text-end">@e.Amount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
