@model List<Category>
@{
    ViewData["Title"] = "Categories";
    var counts = (Dictionary<int, int>)ViewBag.ExpenseCounts;
}

<h1>Categories</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add Category</a>
</p>

@if (Model.Count == 0)
{
    <p class="text-muted">No categories yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Monthly Budget</th>
                <th class="text-end">Expenses</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Name</td>
                    <td class="text-end">@(c.MonthlyBudget?.ToString("C") ?? "-")</td>
                    <td class="text-end">@counts.GetValueOrDefault(c.Id)</td>
                    <td class="text-nowrap text-end">
                        <a asp-action="Edit" asp-route-id="@c.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@c.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
