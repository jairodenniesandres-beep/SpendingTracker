@model Category

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="MonthlyBudget" class="form-label"></label>
    <input asp-for="MonthlyBudget" type="number" step="0.01" min="0" max="1000000" class="form-control" />
    <div class="form-text">Optional. Leave empty for no budget.</div>
    <span asp-validation-for="MonthlyBudget" class="text-danger"></span>
</div>
